# Server (apps/server). Defaults: PORT=8787, MOCK_MODE=true outside production.
# Mobile env lives in apps/mobile/.env (see apps/mobile/.env.example) because Expo reads .env from the app folder.
NODE_ENV=
PORT=
MOCK_MODE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional. Local requests-per-minute limiter across every Gemini call (sliding window).
# This does not increase the Gemini project quota; set it at or below the quota shown in AI Studio.
GEMINI_RPM=
# Optional. debug | info | warn | error. Default info.
LOG_LEVEL=
GOOGLE_MAPS_API_KEY=
TICKETMASTER_API_KEY=
RESEND_API_KEY=
