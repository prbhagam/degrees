# Server (apps/server). Defaults: PORT=8787, MOCK_MODE=true outside production.
# Mobile env lives in apps/mobile/.env (see apps/mobile/.env.example) because Expo reads .env from the app folder.
NODE_ENV=
PORT=
MOCK_MODE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional. Requests per minute across every Gemini call (sliding window). Default 15 = the free tier.
GEMINI_RPM=
# Optional. debug | info | warn | error. Default info.
LOG_LEVEL=
# Optional. true = POST /groups/:id/activity returns a 'generating' placeholder and a Netlify Background Function
# writes the plan (needs a Pro-or-higher Netlify plan). Default false = generate inline within the 9s budget.
ACTIVITY_BACKGROUND=
GOOGLE_MAPS_API_KEY=
TICKETMASTER_API_KEY=
RESEND_API_KEY=
