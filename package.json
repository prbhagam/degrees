{
  "name": "degrees",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @degrees/server",
    "dev:mobile": "npm run start -w @degrees/mobile",
    "ios": "npm run ios -w @degrees/mobile",
    "typecheck": "npm run typecheck -w @degrees/shared -w @degrees/server -w @degrees/mobile && tsc -p supabase/tsconfig.json --noEmit",
    "export:ios": "npm run export:ios -w @degrees/mobile",
    "doctor": "npm run doctor -w @degrees/mobile",
    "seed": "tsx supabase/seed/seed.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.3"
  }
}
