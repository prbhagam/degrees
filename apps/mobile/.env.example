# Mobile (apps/mobile) — Expo inlines EXPO_PUBLIC_* into the app bundle, so these are public by design.
# Only the Supabase publishable (anon) key belongs here; never the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Unset in dev = the API on this machine at port 8787, reached via the Metro host.
EXPO_PUBLIC_API_URL=
